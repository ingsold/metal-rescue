rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
    
    function isSignedIn() {
      return request.auth != null;
    }
    
    function existing() {
      return resource.data;
    }
    
    function incoming() {
      return request.resource.data;
    }
    
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'administrador'
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    match /usernames/{username} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    match /roles/{roleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) &&
                       incoming().keys().hasAll(['name', 'email', 'role', 'createdAt', 'status', 'lastName', 'username']) &&
                       incoming().name is string && incoming().name.size() <= 100 &&
                       incoming().email is string && incoming().email.size() <= 100 &&
                       (incoming().role == 'donante' || (incoming().email == 'admin@metalrescue.org' && incoming().role == 'administrador')) &&
                       incoming().status == 'active';
      allow update: if (isOwner(userId) || isAdmin()) &&
                       (isAdmin() || incoming().diff(existing()).affectedKeys().hasOnly(['name', 'lastName', 'username'])) &&
                       (!incoming().diff(existing()).affectedKeys().hasAny(['role', 'status']) || isAdmin());
    }

    match /products/{productId} {
      // Products can be read by public if approved or sold. Owners can read their own pending/rejected items. Admins can read all.
      allow read: if resource.data.estado_publicacion in ['aprobado_publicado', 'vendido', 'reservada'] || 
                     isOwner(resource.data.usuario_donante_id) || 
                     isAdmin();
      
      allow create: if isSignedIn() &&
                       incoming().keys().hasAll(['imagen_url', 'banda_artista', 'tipo_prenda', 'estado_conservacion', 'precio_estimado_donante', 'estado_publicacion', 'fecha_donacion', 'usuario_donante_id', 'usuario_donante_nombre']) &&
                       incoming().imagen_url is string &&
                       incoming().banda_artista is string && incoming().banda_artista.size() <= 100 &&
                       incoming().tipo_prenda is string && incoming().tipo_prenda.size() <= 50 &&
                       incoming().estado_conservacion is string && incoming().estado_conservacion.size() <= 50 &&
                       incoming().precio_estimado_donante is number &&
                       incoming().estado_publicacion == 'borrador_pendiente' &&
                       incoming().fecha_donacion is string && incoming().fecha_donacion.size() <= 100 &&
                       incoming().usuario_donante_id == request.auth.uid &&
                       incoming().usuario_donante_nombre is string && incoming().usuario_donante_nombre.size() <= 100;
                       
      // Users can reserve items (buy), admins can approve/update status
      allow update: if isSignedIn() && (
                       isAdmin() || 
                       // Normal users can only change state to 'vendido' if they buy it
                       (incoming().diff(existing()).affectedKeys().hasOnly(['estado_publicacion', 'fecha_venta']) && 
                        incoming().estado_publicacion in ['vendido', 'reservada'] &&
                        existing().estado_publicacion == 'aprobado_publicado')
                     );
                     
      allow delete: if isAdmin() || (isOwner(resource.data.usuario_donante_id) && resource.data.estado_publicacion == 'borrador_pendiente');
    }
    
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /events/{eventId} {
      // Public can only read active events
      allow read: if true; // Wait, actually it's fine for public to see canceled events since UI shows them
      allow write: if isAdmin();
    }
    
    match /deliveries/{deliveryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /notifications/{notificationId} {
      // Users can read their own notifications
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      // Anyone can create (e.g. buyer creates notification for donor), or Admin
      allow create: if isSignedIn() &&
                       incoming().keys().hasAll(['userId', 'message', 'read', 'date']) &&
                       incoming().userId is string && incoming().userId.size() <= 128 &&
                       incoming().message is string && incoming().message.size() <= 500 &&
                       incoming().read == false &&
                       incoming().date is string && incoming().date.size() <= 50;
                       
      // Users can mark their own notifications as read
      allow update: if isSignedIn() && 
                       existing().userId == request.auth.uid &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['read']) &&
                       incoming().read == true;
                       
      allow delete: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
